# DevAssistant - Variables de entorno
# Copia este archivo como .env y agrega tus API keys reales
# NUNCA commitees el archivo .env

# === API Keys ===
# Obtén tu key en: https://console.anthropic.com  (obligatoria: el agente usa Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obtén tu key en: https://platform.openai.com/api-keys  (solo para embeddings del RAG)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Configuración del modelo ===
# Modelo de Anthropic a usar (opciones: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Modelo de embeddings de OpenAI (text-embedding-3-small = 1536 dims, text-embedding-3-large = 3072 dims)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional: dimensiones del embedding si usas un modelo que DevAssistant no conoce
# EMBEDDING_DIMENSIONS=1536

# === RAG ===
# Directorio donde está la documentación a indexar (se recorre con subcarpetas)
DOCS_PATH=./docs/sample-project

# Ruta a la base de datos de vectores
DB_PATH=./data/vectors.db

# Número de chunks a recuperar por búsqueda
RAG_TOP_K=5
